# ============================================================
# DairyOS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or real credentials to version control.
# ============================================================

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------
# NODE_ENV=development | staging | production
NODE_ENV=development

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql://dairy:local_dev_password@localhost:5432/dairy

# ------------------------------------------------------------
# Server / Session
# ------------------------------------------------------------
# Port the API server listens on.
PORT=4000

# JWT signing secret. MUST be a long random string in production.
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret

# Access token lifetime (e.g. 30m, 1h, 2h).
JWT_EXPIRES_IN=30m

# Refresh token lifetime in days. Controls how long a session remains valid.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
# Public URL of the frontend (used for CORS and OAuth redirects).
# Development:  http://localhost:5173
# Staging:      https://staging.dairyos.com
# Production:   https://app.dairyos.com
FRONTEND_URL=http://localhost:5173

# Vite-exposed API URL for the frontend build.
# This must be an absolute URL in production so the browser can reach the API.
# Development:  http://localhost:4000/api/v1
# Staging:      https://api-staging.dairyos.com/api/v1
# Production:   https://api.dairyos.com/api/v1
VITE_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------
# Create OAuth 2.0 Client ID at:
# https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URIs (exact match):
#   Development:  http://localhost:4000/api/v1/auth/oauth/google/callback
#   Staging:      https://api-staging.dairyos.com/api/v1/auth/oauth/google/callback
#   Production:   https://api.dairyos.com/api/v1/auth/oauth/google/callback
#
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/google/callback

# ------------------------------------------------------------
# Microsoft OAuth
# ------------------------------------------------------------
# Register app at:
# https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsList
#
# Authorized redirect URIs (exact match):
#   Development:  http://localhost:4000/api/v1/auth/oauth/microsoft/callback
#   Staging:      https://api-staging.dairyos.com/api/v1/auth/oauth/microsoft/callback
#   Production:   https://api.dairyos.com/api/v1/auth/oauth/microsoft/callback
#
OAUTH_MICROSOFT_CLIENT_ID=your-microsoft-client-id
OAUTH_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
OAUTH_MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/microsoft/callback

# ------------------------------------------------------------
# Apple Sign In
# ------------------------------------------------------------
# Configure at:
# https://developer.apple.com/account/resources/identifiers/list
#
# Authorized redirect URIs (exact match):
#   Development:  http://localhost:4000/api/v1/auth/oauth/apple/callback
#   Staging:      https://api-staging.dairyos.com/api/v1/auth/oauth/apple/callback
#   Production:   https://api.dairyos.com/api/v1/auth/oauth/apple/callback
#
OAUTH_APPLE_CLIENT_ID=com.yourcompany.dairyos.web
OAUTH_APPLE_TEAM_ID=your-apple-team-id
OAUTH_APPLE_KEY_ID=your-apple-key-id
OAUTH_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
OAUTH_APPLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/apple/callback

# ------------------------------------------------------------
# Optional: Google Maps
# ------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-javascript-api-key

# ------------------------------------------------------------
# Optional: Learning cycle
# ------------------------------------------------------------
# How often the AI continuous-learning cycle runs (hours).
LEARNING_CYCLE_INTERVAL_HOURS=6
