{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "apps/server/dist/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
